  "leaderboards": [
    {"id":"board_composite",         "name":"综合战力榜",   "sort":"desc", "keep":"best", "display":"number"},
    {"id":"board_kills_per_match",   "name":"单局击杀榜",   "sort":"desc", "keep":"best", "display":"number"},
    {"id":"board_shortest_win_sec",  "name":"最速通关榜",   "sort":"asc",  "keep":"best", "display":"seconds"},
    {"id":"board_biggest_army",      "name":"暴兵大师榜",   "sort":"desc", "keep":"best", "display":"number"}
  ],
  "displays": [
    {"id":"disp_matches", "type":"number", "title":"我的总对局", "format":"integer",
      "source": {"type":"stat_player", "stat_id":"matches_total"}},
    {"id":"disp_wins", "type":"number", "title":"我的胜场", "format":"integer",
      "source": {"type":"stat_player", "stat_id":"wins_total"}},
    {"id":"disp_kills", "type":"number", "title":"我的击杀", "format":"integer",
      "source": {"type":"stat_player", "stat_id":"kills_total"}},
    {"id":"disp_gold",   "type":"number", "title":"我的累计金钱", "format":"integer",
      "source": {"type":"stat_player", "stat_id":"gold_earned_total"}},

    {"id":"disp_lb_composite", "type":"leaderboard", "title":"综合战力榜 Top 10",
      "board_id":"board_composite", "limit": 10},
    {"id":"disp_lb_speed", "type":"leaderboard", "title":"最速通关榜 Top 10",
      "board_id":"board_shortest_win_sec", "limit": 10},

    {"id":"disp_side_pie", "type":"pie", "title":"我的阵营偏好",
      "series":[
        {"label":"🏙️ 香港", "color":"#1e5599", "source":{"type":"stat_player","stat_id":"matches_as_hk"}},
        {"label":"🧟 僵尸", "color":"#5a1a1a", "source":{"type":"stat_player","stat_id":"matches_as_zom"}}
      ]},

    {"id":"disp_civ_bar", "type":"bar", "title":"我的文明使用",
      "series":[
        {"label":"中环金融", "color":"#1e5599", "source":{"type":"stat_player","stat_id":"civ_used_hk_finance"}},
        {"label":"深水埗",   "color":"#7d4c1c", "source":{"type":"stat_player","stat_id":"civ_used_hk_slum"}},
        {"label":"湾仔差馆", "color":"#2e6e4a", "source":{"type":"stat_player","stat_id":"civ_used_hk_police"}},
        {"label":"末日尸潮", "color":"#5a1a1a", "source":{"type":"stat_player","stat_id":"civ_used_zom_classic"}},
        {"label":"港式怪谈", "color":"#4a1a4a", "source":{"type":"stat_player","stat_id":"civ_used_zom_ghost"}},
        {"label":"病毒实验", "color":"#204a2a", "source":{"type":"stat_player","stat_id":"civ_used_zom_bio"}}
      ]},

    {"id":"disp_global_kills", "type":"number", "title":"全服累计击杀", "format":"integer",
      "source":{"type":"stat_global","stat_id":"kills_total","agg":"sum"}},

    {"id":"disp_achievements", "type":"achievement_rates", "title":"全球成就完成率"}
  ]
}
