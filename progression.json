    {"id":"warlord",           "name":"军阀",             "description":"累计胜利数达到 10。",
      "bind_stat":"wins_total", "unlock_at": 10},
    {"id":"rich_10k",          "name":"财源广进",         "description":"累计赚取金钱达到 10000。",
